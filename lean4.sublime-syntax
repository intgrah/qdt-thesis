%YAML 1.2
---
name: Lean 4
file_extensions: [lean]
scope: source.lean4

contexts:
  main:
    - include: comments

    # ----------------------------------------------------------------------
    # USER-DEFINED EXTRA KEYWORDS — edit this pipe-separated list.
    # ----------------------------------------------------------------------
    - match: '\b(?<!\.)(MY_KEYWORD|ANOTHER_KEYWORD)(?!\.)\b'
      scope: keyword.other.lean4

    - match: '\b(Prop|Type|Sort)\b'
      scope: storage.type.lean4

    - match: '\b(?<!\.)(local|scoped|partial|unsafe|nonrec|public|private|protected|noncomputable|meta)(?!\.)\b'
      scope: storage.modifier.lean4

    - match: '\b(sorry|admit|#exit)\b'
      scope: invalid.illegal.lean4

    - match: '#(print|eval|eval!|reduce|synth|widget|where|version|check|check_tactic|check_tactic_failure|check_failure|check_simp|guard|guard_expr|guard_msgs)\b'
      scope: keyword.other.lean4

    - match: '\b(?<!\.)(theorem|show|have|using|haveI|from|suffices|nomatch|nofun|def|class|structure|instance|elab|set_option|initialize|builtin_initialize|example|inductive|coinductive|termination_by|decreasing_by|partial_fixpoint|axiom|universe|variable|module|import|open|export|prelude|renaming|hiding|do|by|let|letI|extends|mutual|mut|where|rec|declare_syntax_cat|syntax|macro_rules|macro|elab_rules|deriving|fun|section|namespace|end|prefix|postfix|infixl|infixr|infix|notation|abbrev|if|bif|then|else|calc|matches|match|with|forall|for|while|repeat|unless|until|try|catch|finally|return|continue|break|exists|in|opaque|omit|seal|unseal|run_cmd|run_meta|run_elab|dbg_trace)(?!\.)\b'
      scope: keyword.other.lean4

    - match: "«"
      push:
        - meta_scope: entity.name.lean4
        - match: "»"
          pop: true

    - include: strings

    - match: '\b(true|false)\b'
      scope: constant.language.lean4

    - match: "(?<!\\]|\\w)'[^\\\\']'"
      scope: string.quoted.single.lean4

    - match: "(?<!\\]|\\w)'(\\\\(x[0-9A-Fa-f][0-9A-Fa-f]|u[0-9A-Fa-f]{4}|.))'"
      scope: string.quoted.single.lean4

    - match: '\b([0-9]+|0[xX][0-9a-fA-F]+|[-]?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?)\b'
      scope: constant.numeric.lean4

  comments:
    - include: doc-comment
    - include: mod-doc-comment
    - include: block-comment
    - include: dash-comment

  dash-comment:
    - match: "--"
      scope: punctuation.definition.comment.lean4
      push:
        - meta_scope: comment.line.double-dash.lean4
        - match: "$"
          pop: true

  doc-comment:
    - match: "/--"
      scope: punctuation.definition.comment.lean4
      push:
        - meta_scope: comment.block.documentation.lean4
        - match: "-/"
          scope: punctuation.definition.comment.lean4
          pop: true
        - include: block-comment

  mod-doc-comment:
    - match: "/-!"
      scope: punctuation.definition.comment.lean4
      push:
        - meta_scope: comment.block.documentation.lean4
        - match: "-/"
          scope: punctuation.definition.comment.lean4
          pop: true
        - include: block-comment

  block-comment:
    - match: "/-(?![-!])"
      scope: punctuation.definition.comment.lean4
      push:
        - meta_scope: comment.block.lean4
        - match: "-/"
          scope: punctuation.definition.comment.lean4
          pop: true
        - include: block-comment

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.lean4
      push:
        - meta_scope: string.quoted.double.lean4
        - match: '"'
          scope: punctuation.definition.string.end.lean4
          pop: true
        - match: '\\[\\"ntr'']'
          scope: constant.character.escape.lean4
        - match: '\\x[0-9A-Fa-f][0-9A-Fa-f]'
          scope: constant.character.escape.lean4
        - match: '\\u[0-9A-Fa-f]{4}'
          scope: constant.character.escape.lean4
